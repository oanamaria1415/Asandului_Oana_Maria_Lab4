@model PricePredictionModel.ModelInput

@{
    ViewData["Title"] = "Taxi Duration Prediction";
}

<h2>Taxi Duration Prediction</h2>
<hr />

<form asp-action="Duration" method="post">
    <div class="form-group">
        <label asp-for="Passenger_count" class="control-label"></label>
        <input asp-for="Passenger_count" type="number" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Trip_distance" class="control-label"></label>
        <input asp-for="Trip_distance" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Payment_type" class="control-label"></label>
        <select asp-for="Payment_type" class="form-control">
            <option value="CSH">Cash</option>
            <option value="CRD">Credit</option>
        </select>
    </div>

    <div class="form-group mt-2">
        <input type="submit" value="Estimate" class="btn btn-primary" />
    </div>
</form>

@if (ViewBag.DurationSeconds != null)
{
    <hr />
    <h3>Result</h3>
    <p>Estimated duration: @ViewBag.DurationSeconds sec</p>
    <p>Estimated duration: @ViewBag.DurationMinutes min</p>
}
